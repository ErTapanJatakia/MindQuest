<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mindquest_splash_background</item>
        <item name="android:statusBarColor">@color/mindquest_splash_background</item>
        <item name="android:navigationBarColor">@color/mindquest_navigation_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/mindquest_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
